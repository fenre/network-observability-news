{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenre.github.io/network-observability-news/schemas/item.schema.json",
  "title": "News item",
  "description": "One normalized, enriched news item. Source of truth lives in data/items.json. Only title, link, metadata and our own summary are stored — never the source article body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "url",
    "canonicalUrl",
    "source",
    "publishedAt",
    "fetchedAt",
    "topics",
    "tags",
    "categories",
    "audiences",
    "summary",
    "summarySource",
    "clusterId",
    "lang",
    "attribution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id: first 16 hex chars of sha1(canonicalUrl).",
      "pattern": "^[0-9a-f]{16}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "canonicalUrl": { "type": "string", "format": "uri" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "homepage": { "type": ["string", "null"] }
      }
    },
    "author": { "type": ["string", "null"] },
    "publishedAt": { "type": "string", "description": "ISO-8601 timestamp." },
    "fetchedAt": { "type": "string", "description": "ISO-8601 timestamp." },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["splunk", "cisco-data-fabric", "network-observability"]
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "description": "Story type for filtering (orthogonal to topics).",
      "items": {
        "type": "string",
        "enum": [
          "product-release",
          "security",
          "outage",
          "tutorial",
          "research",
          "standards",
          "news",
          "event"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "audiences": {
      "type": "array",
      "description": "Agent/region targeting. global = default; nordics* = Norway/Denmark partner slice.",
      "items": {
        "type": "string",
        "enum": ["global", "nordics", "nordics-no", "nordics-dk"]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "agentNote": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional static briefing hint for AI agents (curated entries)."
    },
    "summary": {
      "type": "string",
      "description": "Neutral, original 2-3 sentence summary. Our own text — not the source body."
    },
    "summarySource": {
      "type": "string",
      "enum": ["llm", "extractive", "curated", "publisher", "none"]
    },
    "clusterId": {
      "type": "string",
      "description": "Near-duplicate cluster id (the lexicographically smallest member id)."
    },
    "lang": { "type": "string", "minLength": 2, "maxLength": 8 },
    "license": { "type": ["string", "null"] },
    "attribution": { "type": "string", "minLength": 1 }
  }
}
